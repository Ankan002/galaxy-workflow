{
	"name": "galaxy-workflow",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev:trigger": "trigger dev",
		"deploy:trigger": "trigger deploy",
		"setup-dev": "bun src/cmd/setup-dev.ts",
		"dev:tunnel": "chmod +x ./dev.sh && ./dev.sh",
		"dev": "next dev",
		"build": "bun run db:push && bun run db:generate && bun run deploy:trigger && bun run db:sync && next build",
		"start": "next start",
		"lint": "eslint",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepare": "husky",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:push": "prisma db push --accept-data-loss",
		"db:push-dev": "prisma db push",
		"db:studio": "prisma studio",
		"db:sync": "bun src/cmd/sync-users.ts"
	},
